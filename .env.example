# External PostgreSQL database connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logistic_controls?schema=public"

# Local Mosquitto broker
MQTT_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_CLIENT_ID="backend-worker-dev"

# App secret and runtime tuning
JWT_SECRET="replace-with-a-long-random-secret"
BCRYPT_ROUNDS="12"

# Seed credentials ae defined in `prisma/seed.ts`
